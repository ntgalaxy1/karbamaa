# ======================================================================
# فایل پیکربندی استاندارد و بهینه آپاچی (.htaccess) برای اپلیکیشن‌های React (SPA)
# سامانه کارباما - کاریابی و اقامت ترکیه
# ======================================================================

# جلوگیری از نمایش لیست فایل‌های موجود در پوشه‌ها
Options -Indexes

# ----------------------------------------------------------------------
# ۱. هدایت تمام مسیرها به index.html (حل مشکل ارور ۴۰۴ در رفرش صفحات)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # انتقال خودکار به HTTPS (برای فعال‌سازی PWA و امنیت)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # اگر فایل یا پوشه فیزیکی در هاست وجود دارد مستقیما باز شود
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # در غیر این صورت همه درخواست‌ها به index.html ارسال شوند
  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# ۲. تعریف انواع فایل‌ها (MIME Types) برای PWA، وب‌فونت‌ها و آیکون‌ها
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .json
  AddType text/javascript           .js .mjs
  AddType text/css                  .css
  AddType image/svg+xml             .svg .svgz
  AddType image/png                 .png
  AddType image/webp                .webp
  AddType image/x-icon              .ico
  AddType font/woff2                .woff2
  AddType font/woff                 .woff
  AddType application/json          .json
</IfModule>

# ----------------------------------------------------------------------
# ۳. هدرهای دسترسی و امنیت (CORS & Security Headers)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # مجوز دسترسی آزاد برای سرویس‌ورکر، مانفیست و ابزارهای PWA
  Header set Access-Control-Allow-Origin "*"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# ۴. فعال‌سازی فشرده‌سازی GZIP برای کاهش ۸۰٪ حجم و افزایش سرعت لود
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# ۵. تنظیم کش مرورگر (Browser Caching)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # فایل HTML اصلی کش نشود تا تغییرات جدید بلافاصله لود شود
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
